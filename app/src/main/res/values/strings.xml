    <string name="about_godraw">About GoDraw</string>
    <string name="privacy">Privacy</string>
    <string name="privacy_text">GoDraw stores your artwork only on this device unless you export or back it up yourself. No account is required and the app contains no advertising, analytics or tracking. The only network use is contacting Google Play and, when subscriptions are configured, the developer\'s verification server to confirm purchases. Android\'s system backup may include your projects if you have enabled device backup.</string>
    <string name="version_value">Version %1$s</string>
    <string name="about_description_title">Your studio for drawing and animation</string>
    <string name="about_description">GoDraw combines professional painting tools, layers, frame-by-frame and keyframe animation, sound and export in one easy-to-use app for phones and tablets.</string>
    <string name="about_offline_title">Works offline</string>
    <string name="about_offline">Drawing, animation, saving and exporting all work without an internet connection.</string>
    <string name="about_licenses_title">Open-source software</string>
    <string name="about_licenses">GoDraw is built with Kotlin, Jetpack Compose, AndroidX (Room, DataStore, Navigation, Lifecycle), kotlinx.coroutines and kotlinx.serialization, licensed under the Apache License 2.0, and the Google Play Billing Library.</string>
