    <string name="about_godraw">אודות GoDraw</string>
    <string name="privacy">פרטיות</string>
    <string name="privacy_text">GoDraw שומרת את היצירות שלך רק במכשיר הזה, אלא אם ייצאת או גיבית אותן בעצמך. אין צורך בחשבון, ואין באפליקציה פרסומות, ניתוח נתונים או מעקב. השימוש היחיד ברשת הוא התקשרות עם Google Play, וכשהמינויים מוגדרים – עם שרת האימות של המפתח לאישור רכישות. גיבוי המערכת של Android עשוי לכלול את הפרויקטים שלך אם הפעלת גיבוי מכשיר.</string>
    <string name="version_value">גרסה %1$s</string>
    <string name="about_description_title">הסטודיו שלך לציור ולאנימציה</string>
    <string name="about_description">GoDraw משלבת כלי ציור מקצועיים, שכבות, אנימציה פריים אחר פריים ובקיפריימים, צליל וייצוא באפליקציה אחת נוחה לטלפונים ולטאבלטים.</string>
    <string name="about_offline_title">עובדת בלי אינטרנט</string>
    <string name="about_offline">ציור, אנימציה, שמירה וייצוא פועלים כולם ללא חיבור לאינטרנט.</string>
    <string name="about_licenses_title">תוכנת קוד פתוח</string>
    <string name="about_licenses">GoDraw נבנתה עם Kotlin, ‏Jetpack Compose, ‏AndroidX (Room, DataStore, Navigation, Lifecycle), ‏kotlinx.coroutines ו-kotlinx.serialization ברישיון Apache 2.0, ועם Google Play Billing Library.</string>
