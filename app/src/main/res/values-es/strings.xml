    <string name="settings_about">Información</string>
    <string name="about_godraw">Acerca de GoDraw</string>
    <string name="privacy">Privacidad</string>
    <string name="privacy_text">GoDraw guarda tus obras solo en este dispositivo, salvo que tú mismo las exportes o hagas una copia de seguridad. No se necesita ninguna cuenta y la aplicación no contiene publicidad, analíticas ni seguimiento. El único uso de la red es comunicarse con Google Play y, cuando las suscripciones están configuradas, con el servidor de verificación del desarrollador para confirmar compras. La copia de seguridad del sistema Android puede incluir tus proyectos si la has activado.</string>
    <string name="version_value">Versión %1$s</string>
    <string name="about_description_title">Tu estudio de dibujo y animación</string>
    <string name="about_description">GoDraw reúne herramientas de pintura profesionales, capas, animación fotograma a fotograma y con fotogramas clave, sonido y exportación en una aplicación sencilla para teléfonos y tabletas.</string>
    <string name="about_offline_title">Funciona sin conexión</string>
    <string name="about_offline">Dibujar, animar, guardar y exportar funcionan sin conexión a Internet.</string>
    <string name="about_licenses_title">Software de código abierto</string>
    <string name="about_licenses">GoDraw está creado con Kotlin, Jetpack Compose, AndroidX (Room, DataStore, Navigation, Lifecycle), kotlinx.coroutines y kotlinx.serialization, con licencia Apache 2.0, y la biblioteca Google Play Billing.</string>
